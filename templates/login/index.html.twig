{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mx-auto w-96">
        <form method="post" class="p-4 rounded-xl shadow-sm bg-white">
            <div class="mb-4">
                <label for="email" class="block text-gray-800 required">Email</label>
                <input type="email" id="email" name="email" value="{{ last_username ?? null }}" class="mt-1 w-full"/>
            </div>

            <div class="mb-4">
                <label for="password" class="block text-gray-800 required">Password</label>
                <input type="password" id="password" name="password" class="mt-1 w-full"/>
            </div>

            {% if error is defined  %}
                <div class="mb-4 text-red-500">{{ error }}</div>
            {% endif %}

            <div class="flex items-center justify-center">
                <button type="submit" class="p-2 rounded bg-gray-300 w-full">Login</button>
            </div>
        </form>
    </div>
{% endblock %}
