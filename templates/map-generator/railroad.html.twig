<div class="w-full flex">
    <div class="w-2/3">
        <div class="p-4 rounded-xl shadow-sm bg-white flex items-center justify-center">
            {% for cell in map.cells %}
                {{ include(cell.template) }}
            {% endfor %}
        </div>
    </div>

    <div class="w-1/3">
        {% for room in map.rooms %}
            <p>{{ loop.index }}: x: {{ room.x }}</p>
        {% endfor %}
    </div>
</div>