<div class="w-full flex">
    <div class="w-1/2">
        <div class="p-4 rounded-xl shadow-sm bg-white flex items-center justify-center">
            {% for cell in map.cells %}
                {{ include(cell.template, { cell: cell }) }}
            {% endfor %}
        </div>
    </div>

    <div class="w-1/2 flex items-start text-xs ">
        <div class="mr-4">
            <h2 class="text-3xl mb-2">Dungeon</h2>

            <p>Length: {{ map.length }}</p>
        </div>

        <div class="mr-4">
            <h2 class="text-3xl mb-2">Rooms</h2>

            {% for room in map.rooms %}
                <h3 class="text-2xl">#{{ loop.index }}</h3>
                <p>x: {{ room.x }}
                <p>treasure: {{ room.treasure ? room.treasure | json_encode() : 'nope' }}</p>
            {% endfor %}
        </div>

        <div class="">
            <h2 class="text-3xl mb-2">Corridors</h2>

            {% for corridor in map.corridors %}
                <h3 class="text-2xl">#{{ loop.index }}</h3>
                <p>x: {{ corridor.x }}</p>
            {% endfor %}
        </div>
    </div>
</div>