<div class="w-full flex items-center justify-center">
    <div class="w-2/3">
        {% for row in range(0, game.map.rowsCount - 1) %}
            <div class="flex justify-center">
                {% for column in range(0, map.columnsCount - 1) %}
                    <div
                        class="flex items-center justify-center w-4 h-4 text-xs {{ game.map.cells[row][column] ? 'bg-white' : 'bg-gray-900' }}"
                    >
                        {{ game.map.cells[row][column] }}
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>

    <div class="w-1/3">
        {% for room in game.map.rooms %}
            <p>{{ loop.index }}: x: {{ room.x }}, y: {{ room.y }}</p>
        {% endfor %}
    </div>
</div>