<div class="mb-4 p-4 rounded-xl shadow-sm bg-white">
    <div class="p-6 text-xs bg-gray-800">
        {% for column in cells %}
            <div class="flex items-center justify-center">
                {% for cell in column %}
                    <div class="w-8 h-8 flex items-center justify-center">
                        {{ include(cell.template) }}
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
</div>
