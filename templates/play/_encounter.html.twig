{% set enemies = encounter.allEnemies %}
{% set obstacles = encounter.obstacles %}
{% set treasures = encounter.treasures %}

<div class="p-4 rounded-xl shadow-sm bg-white">
    <div class="mb-4">
        <h2 class="text-4xl">{{ encounter.difficulty.name }} encounter</h2>
    </div>

    {% if enemies is not empty %}
        <div class="mt-4">
            <h3 class="text-3xl mb-2">Enemies</h3>

            <div class="grid grid-cols-3 gap-4">
                {% for enemy in enemies %}
                    <div class="p-4 border border-black rounded-md">
                        <h4 class="flex items-center justify-center text-xl font-bold">{{ enemy.name }}</h4>
                        {% if enemy.alive %}
                            <p>HP: {{ enemy.totalHitPoints }} AC: {{ enemy.armorClass }}</p>
                            {% for attack in enemy.attacks %}
                                <p>{{ attack }}</p>
                            {% endfor %}
                        {% else %}
                            <p class="mt-4 flex items-center justify-center text-5xl">☠</p>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

        {% if not encounter.isResolved %}
            <div class="mt-4">
                <h3 class="text-3xl mb-2">Actions (WIP)</h3>

                <ul class="list-disc mt-4 ml-4">
                    <li>
                        <span class="font-bold">Kill 'Em All!</span>
                        (Roll the fight manually. If won, click
                        <form action="/play" method="post">
                            <input hidden name="action" value="encounter">
                            <input hidden name="result" value="all_slain">
                            <button type="submit" class="p-1 bg-gray-300">here</button>
                        </form>)
                    </li>
                    <li><span class="font-bold">Run you fools!</span> (Try to run. Use movement buttons to came back)</li>
                </ul>
            </div>
        {% else %}
            <div class="mt-4">
                <h3 class="text-3xl mb-2">Treasures</h3>

                <div class="grid grid-cols-3 gap-4">
                    {% for treasure in treasures %}
                        <div class="p-4 border border-black rounded-md">
                            <h4 class="flex items-center justify-center text-xl font-bold">{{ treasure.name }}</h4>
                            {% if not treasure.pickedUp %}
                                <form action="/play" method="post">
                                    <input hidden name="action" value="encounter">
                                    <input hidden name="result" value="treasure_picked_up:{{ loop.index0 }}">
                                    <button type="submit" class="p-1 bg-gray-300"><span class="font-bold">Pick up</span></button>
                                </form>
                            {% endif %}
                        </div>
                    {% else %}
                        <p>Nothing to pick up<p>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    {% endif %}

    {% if obstacles is not empty %}
        <div class="mt-4">
            <h3 class="text-3xl mb-2">Obstacles</h3>

            <div class="grid grid-cols-3 gap-4">
                {% for obstacle in obstacles %}
                    <div class="p-4 border border-black rounded-md">
                        <h4 class="flex items-center justify-center text-xl font-bold">{{ obstacle.name }}</h4>
                        {% if not obstacle.isRemoved %}
                            <p>DC to spot: {{ obstacle.dcToSpot }}</p>
                            <p>DC to remove: {{ obstacle.dcToRemove }}</p>
                        {% else %}
                            <p class="mt-4 flex items-center justify-center text-5xl">done</p>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

        {% if not encounter.isResolved %}
            <div class="mt-4">
                <h3 class="text-3xl mb-2">Actions (WIP)</h3>

                <ul class="list-disc mt-4 ml-4">
                    <li>
                        <span class="font-bold">Remove obstacle.</span>
                        Came up with an idea to remove the obstacle. Roll manually to resolve and then click
                        <form action="/play" method="post">
                            <input hidden name="action" value="encounter">
                            <input hidden name="result" value="obstacle_removed">
                            <button type="submit" class="p-1 bg-gray-300">here</button>
                        </form>when finished
                    </li>
                    <li>
                        <span class="font-bold">Go back.</span> Use movement buttons to came back.
                    </li>
                </ul>
            </div>
        {% endif %}
    {% endif %}
</div>
