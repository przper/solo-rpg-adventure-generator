{% if game.movementType == enum('App\\Enum\\MovementType').OneDimension  %}
    <div class="flex items-center justify-center">
        <form class="mr-4">
            <input type="hidden" name="direction" value="backward">
            <button type="submit" class="p-2 rounded bg-gray-200 hover:bg-gray-300">
                Backward...
            </button>
        </form>
        <form class="mr-4">
            <input type="hidden" name="direction" value="forward">
            <button type="submit" class="p-2 rounded bg-gray-200 hover:bg-gray-300">
                Forward!
            </button>
        </form>
    </div>
{% endif %}

{% if game.movementType == enum('App\\Enum\\MovementType').TwoDimension  %}
    <div class="grid grid-cols-3 gap-2">
        <div></div>
        <form>
            <input type="hidden" name="direction" value="north">
            <button type="submit" class="w-full p-2 rounded">North</button>
        </form>
        <div></div>
        <form>
            <input type="hidden" name="direction" value="west">
            <button type="submit" class="w-full p-2 rounded">West</button>
        </form>
        <div></div>
        <form>
            <input type="hidden" name="direction" value="east">
            <button type="submit" class="w-full p-2 rounded">East</button>
        </form>
        <div></div>
        <form>
            <input type="hidden" name="direction" value="south">
            <button type="submit" class="w-full p-2 rounded">South</button>
        </form>
        <div></div>
    </div>
{% endif %}
