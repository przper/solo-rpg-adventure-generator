    <div class="grid grid-cols-3 gap-2">
        {% if game.map.dimension == enum('App\\Enum\\MapDimension').TwoDimension  %}
            <div></div>
            {% if 'north' in game.availableActions.movement %}
                <form method="post">
                    <input type="hidden" name="direction" value="north">
                    <button type="submit" class="w-full p-2 rounded bg-gray-300">North</button>
                </form>
            {% else %}
                <button class="w-full p-2 bg-gray-200 text-gray-400 cursor-not-allowed" disabled>North</button>
            {% endif %}
            <div></div>
        {% endif %}

        {% if 'west' in game.availableActions.movement %}
            <form method="post">
                <input type="hidden" name="direction" value="west">
                <button type="submit" class="w-full p-2 rounded bg-gray-300">West</button>
            </form>
        {% else %}
            <button class="w-full p-2 bg-gray-200 text-gray-400 cursor-not-allowed" disabled>West</button>
        {% endif %}

        {% if game.map.dimension == enum('App\\Enum\\MapDimension').TwoDimension  %}
            <div></div>
        {% endif %}

        {% if 'east' in game.availableActions.movement %}
            <form method="post">
                <input type="hidden" name="direction" value="east">
                <button type="submit" class="w-full p-2 rounded bg-gray-300">East</button>
            </form>
        {% else %}
            <button class="w-full p-2 bg-gray-200 text-gray-400 cursor-not-allowed" disabled>East</button>
        {% endif %}

        {% if game.map.dimension == enum('App\\Enum\\MapDimension').TwoDimension  %}
            <div></div>
            {% if 'south' in game.availableActions.movement %}
                <form method="post">
                    <input type="hidden" name="direction" value="south">
                    <button type="submit" class="w-full p-2 rounded bg-gray-300">South</button>
                </form>
            {% else %}
                <button class="w-full p-2 bg-gray-200 text-gray-400 cursor-not-allowed" disabled>South</button>
            {% endif %}
            <div></div>
        {% endif %}
    </div>
