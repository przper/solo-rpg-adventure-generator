{% extends 'base.html.twig' %}

{% block title %}New Game{% endblock %}

{% block body %}
<div class="container mx-auto">
    <h1 class="text-4xl mb-6">{{ heading }}</h1>

    <div class="mb-6 rounded-xl shadow-sm bg-white">
        <p>Description</p>
    </div>

    <div>
        <ul class="">
            <li>
                <form class="mr-4">
                    <input type="hidden" name="type" value="railroad">
                    <button type="submit"><strong>WIP</strong> Railroad</button>
                </form>
            </li>
            <li>
                <form class="mr-4">
                    <input type="hidden" name="type" value="roguelike">
                    <button type="submit"><strong>WIP</strong> Roguelike</button>
                </form>
            </li>
        </ul>
    </div>

</div>

{% endblock %}