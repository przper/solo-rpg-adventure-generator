{% extends 'base.html.twig' %}

{% block title %}Railroad Dungeon{% endblock %}

{% block body %}
<div class="container mx-auto">
    <h1 class="text-4xl mb-6">{{ heading }}</h1>

    <div class="mb-6 rounded-xl shadow-sm bg-white">
        <p>Description</p>
    </div>


    <div class="w-full flex">
        <div class="w-2/3">
            <div>{{ map | raw }}</div>

            <div class="flex items-center">
                <p class="mr-4">Position: {{ game.playerPosition.coordinates }}</p>
            
                <form class="mr-4">
                    <input type="hidden" name="direction" value="backward">
                    <button type="submit">Backward...</button>
                </form>
                <form class="mr-4">
                    <input type="hidden" name="direction" value="forward">
                    <button type="submit">Forward!</button>
                </form>
            </div>

        </div>

        <div class="w-1/3 flex items-start">
            <div class="mr-4">
                <h2 class="text-3xl mb-2">Dungeon</h2>

                <p>Length: {{ game.map.length ?? 'N\A' }}</p>
            </div>

            <div class="mr-4">
                <h2 class="text-3xl mb-2">Rooms</h2>

                {% for room in game.map.rooms %}
                    <h3 class="text-2xl">#{{ loop.index }}</h3>
                    <p>position: {{ room.coordinates }}
                    <p>treasure: {{ room.treasure ? room.treasure | json_encode() : 'nope' }}</p>
                {% endfor %}
            </div>
        </div>
    <div>

</div>

{% endblock %}