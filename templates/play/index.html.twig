{% extends 'base.html.twig' %}

{% block title %}Railroad Dungeon{% endblock %}

{% block body %}
<div class="container mx-auto w-1/2">
    <h1 class="mb-6 text-4xl flex justify-center">{{ heading }}</h1>

    <div class="mb-6 w-full">
        <div class="">
            <div>{{ map.html|raw }}</div>

            <div class="mb-4 flex items-center justify-center">
                <p class="mr-4">Position: {{ game.playerPosition.coordinates }}</p>

                {%  include 'play/_movement.html.twig' %}
            </div>
        </div>

        <div class="p-4 rounded-xl shadow-sm bg-white">
            {% set currentCell = game.map.getTile(game.playerPosition.coordinates) %}

            {% if currentCell %}
                <div class="mb-2">
                    <h2 class="text-3xl">Treasure</h2>
                    <p>{{ currentCell.treasure|json_encode() }}</p>
                </div>

                <div class="mb-2">
                    <h2 class="text-3xl">Enemies</h2>
                    <ul>
                        {% for enemy in currentCell.enemies ?? [] %}
                            <li>{{ enemy|json_encode() }}</li>
                        {% else %}
                            <li>No monster to slay.</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>

