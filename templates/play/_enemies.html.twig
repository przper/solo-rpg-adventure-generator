{% set enemies = encounter.enemies %}

<div class="p-4 rounded-xl shadow-sm bg-white">
    <div class="mb-4">
        <h2 class="text-4xl">{{ encounter.difficulty.name }} encounter</h2>
    </div>

    {% if enemies is not empty %}
        <div class="mt-4">
            <h3 class="text-3xl mb-2">Enemies</h3>

            <div class="grid grid-cols-3 gap-4">
                {% for enemy in enemies %}
                    <div class="p-4 border border-black rounded-md">
                        <h4 class="text-xl font-bold">{{ enemy.name }}</h4>
                        <p>HP: {{ enemy.totalHitPoints }} AC: {{ enemy.armorClass }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="mt-4">
            <h3 class="text-3xl mb-2">Actions (WIP)</h3>

            <ul class="list-disc mt-4 ml-4">
                <li><span class="font-bold">Kill 'Em All!</span> (Roll the fight manually. If won, click <button class="p-1 bg-gray-300">here (TODO)</button>)</li>
                <li><span class="font-bold">Run you fools!</span> (Try to run. Use movement buttons to came back)</li>
            </ul>
        </div>
    {% endif %}
</div>
